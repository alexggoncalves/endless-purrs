:root {
}

.interact-prompt {
    position: absolute;
    flex-direction: row;
    flex-shrink: 1;
    padding-bottom: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.input-prompt_key {
    width: 26px;
    overflow: hidden;
    flex-shrink: 0;
    justify-content: center;
    align-self: center;
    aspect-ratio: 0.91875;
}

.prompt_label {
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    flex-grow: 0;
    flex-direction: column;
    align-items: auto;
    justify-content: space-evenly;
    align-content: stretch;
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Jersey25-Regular.ttf?fileID=12800000&guid=5f567939a26959b4ba72a38ac26972f5&type=3#Jersey25-Regular");
    letter-spacing: 5px;
    font-size: 22px;
    margin-bottom: 0;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.494);
    position: absolute;
    bottom: 0;
    margin-left: 7px;
    left: 100%;
    right: auto;
}
